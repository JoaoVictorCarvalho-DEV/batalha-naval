<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PontuacaoController">

    <!-- TOPO -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: dodgerblue; -fx-padding: 10;">

            <Button onAction="#viewMenu" text="Voltar" />

            <Label text="Pontuação" textFill="#fafafa">
                <font>
                    <Font name="Cascadia Code Regular" size="18.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <!-- CENTRO -->
    <center>
        <TableView VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Jogador 1" />
                <TableColumn text="Jogador 2" />
                <TableColumn text="N. de jogadas" />
                <TableColumn text="Tempo de jogo" />
                <TableColumn text="Data do jogo" />
            </columns>
        </TableView>
    </center>

</BorderPane>
