<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.game.GameController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="50" style="-fx-background-color: dodgerblue; -fx-padding: 10;">
                <children>
                    <Button mnemonicParsing="false" onAction="#viewMenu" text="Voltar" />
                    <Label prefHeight="18.0" prefWidth="200.0" text="Batalha Naval" textFill="WHITE">
                        <font>
                            <Font name="Cascadia Code Regular" size="18.0" />
                        </font>
                    </Label>
                </children>
            </HBox>

            <HBox alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-padding: 8;">
                <children>
                    <Label fx:id="labelInstrucoes" text="FASE DE POSICIONAMENTO: Pressione 'R' para rotacionar o navio">
                        <font>
                            <Font name="Cascadia Code Regular" size="14.0" />
                        </font>
                    </Label>
                </children>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="50">
            <VBox alignment="CENTER" spacing="10">
                <Label text="Seu Tabuleiro"/>
                <GridPane fx:id="playerBoard" hgap="2" vgap="2"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label text="Tabuleiro Inimigo"/>
                <GridPane fx:id="enemyBoard" hgap="2" vgap="2"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>

